# Bu faylni nusxalab, nomini ".env" qiling va qiymatlarni to'ldiring.
# .env fayli GitHub'ga yuklanmaydi (.gitignore'da ko'rsatilgan).

# @BotFather bergan token
BOT_TOKEN=123456789:AAAA-bu-yerga-o'z-tokeningizni-yozing

# Ma'lumotlar bazasi. Sinash uchun SQLite (hech narsa o'rnatish shart emas):
DATABASE_URL=sqlite+aiosqlite:///./tarix.db
# Serverda PostgreSQL uchun misol (Neon manzilini o'zgartirmay qo'yish mumkin):
# DATABASE_URL=postgresql+asyncpg://user:parol@localhost:5432/tarix

# Adminlarning Telegram ID raqamlari, vergul bilan (ID'ni @userinfobot orqali bilasiz)
ADMIN_IDS=123456789

# "Tarixda bugun" postlari uchun kanal (masalan @mening_kanalim). Bo'sh qolsa — faqat botga.
CHANNEL_ID=

# Vaqt zonasi va standart eslatma vaqti
TIMEZONE=Asia/Tashkent
REMINDER_TIME=19:00
DAILY_QUESTION_COUNT=10

# Bitta testdagi savollar soni
QUIZ_LENGTH=10

# "Tarixda bugun" posti har kuni shu vaqtda yuboriladi (kanalga va bot foydalanuvchilariga)
HISTORY_POST_TIME=09:00

# Mini App manzili (HTTPS bo'lishi shart). Render'da bo'sh qoldiring — domen avtomatik olinadi
WEBAPP_URL=

# Server porti
PORT=8000

# FAQAT kompyuterda sinash uchun: Telegram'siz brauzerda shu ID bilan kirish.
# Serverga joylaganda bo'sh qoldiring yoki 0 qiling!
DEV_TELEGRAM_ID=0

# Referal tizimi: do'st nechta savol yechgach taklif hisoblanadi va qancha XP beriladi
REFERRAL_MIN_ANSWERS=5
REFERRAL_XP_INVITER=50
REFERRAL_XP_INVITED=20
# Bot username (@siz). Bo'sh bo'lsa bot o'zi aniqlaydi
BOT_USERNAME=
